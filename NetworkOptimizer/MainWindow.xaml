<Window x:Class="NetworkOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetworkOptimizer.UI.ViewModels"
        Title="NetworkOptimizer - Optimizador de Red para Windows"
        Height="760" Width="1120"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Header -->
            <RowDefinition Height="*" />    <!-- 1: TabControl con Contenido Integrado -->
            <RowDefinition Height="Auto" /> <!-- 2: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PrimaryAccentGradient}" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#090D14" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NETWORK" FontWeight="Black" FontSize="17" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="OPTIMIZER" FontWeight="Black" FontSize="17" Foreground="{StaticResource BrushCyan}" Margin="4,0,0,0" />
                            <Border Background="#1E2A3A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Versión actual instalada">
                                <TextBlock Text="{Binding Update.CurrentVersionDisplay, FallbackValue='v1.0.0'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Diagnóstico, Optimización Segura y Mantenimiento de Red" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Notificación de Actualización (Columna 1) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"
                            Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Border Background="#162536" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 Nueva versión disponible: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding Update.AvailableVersion}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ModernButton}"
                            Command="{Binding Update.ApplyUpdateCommand}"
                            Background="{StaticResource PrimaryAccentGradient}"
                            Foreground="#090D14"
                            FontWeight="Bold"
                            ToolTip="Descarga e instala la actualización automáticamente"
                            Padding="12,6">
                        <TextBlock Text="{Binding Update.UpdateButtonText}" FontSize="12" FontWeight="Bold" />
                    </Button>
                </StackPanel>

                <!-- Elevation & License Badges & Acciones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Badge Licencia Activa / Sin Licencia -->
                    <Border CornerRadius="6" Padding="12,6" Margin="0,0,10,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                        <Setter Property="Background" Value="#122E28" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushEmerald}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLicensed}" Value="False">
                                        <Setter Property="Background" Value="#2A1818" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushCoral}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="✓ Licencia Activa" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushEmerald}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="False">
                                            <Setter Property="Text" Value="🔒 Sin Licencia" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushCoral}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Botón Activar Licencia (visible sólo si no está activado) -->
                    <Button Style="{StaticResource ModernButton}"
                            Command="{Binding NavigateToLicenseCommand}"
                            Visibility="{Binding IsLicensed, Converter={StaticResource InvBoolToVis}}"
                            ToolTip="Abrir panel de licencias para activar clave de producto"
                            Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="🔑 Activar" FontSize="12" />
                    </Button>

                    <!-- Badge Modo Elevado / Normal -->
                    <Border CornerRadius="6" Padding="12,6" Margin="0,0,10,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                        <Setter Property="Background" Value="#122E28" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushEmerald}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                        <Setter Property="Background" Value="#222018" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAmber}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                            <Setter Property="Text" Value="🛡️ Modo Administrador" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushEmerald}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                            <Setter Property="Text" Value="👤 Modo Estándar" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushAmber}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Botón Elevar si está en modo usuario -->
                    <Button Style="{StaticResource ModernButton}"
                            Command="{Binding RequestElevationCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}"
                            ToolTip="Reinicia la aplicación con privilegios de Administrador para todas las operaciones"
                            Padding="10,6">
                        <TextBlock Text="🛡️ Elevar App" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. TAB CONTROL INTEGRADO -->
        <TabControl Grid.Row="1" x:Name="MainTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- TAB 1: DIAGNÓSTICO -->
            <TabItem Header="⚡ Diagnóstico" DataContext="{Binding Dashboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel>
                        <!-- Banner: Requiere Activación de Licencia -->
                        <Border Background="#2A1818" BorderBrush="{StaticResource BrushCoral}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding IsLicensed, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Producto no activado — Funciones protegidas" FontWeight="Bold" Foreground="{StaticResource BrushCoral}" FontSize="13" />
                                        <TextBlock Text="Se requiere una licencia activa para ejecutar mediciones de Ping, Jitter y pérdida de paquetes." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                        Command="{Binding DataContext.NavigateToLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="🔑 Activar Licencia" Padding="14,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Fila 1: Resumen de Interfaces (4 Cards) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tarjeta 1: Adaptador -->
                            <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ADAPTADOR PRINCIPAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    <TextBlock Text="{Binding SelectedAdapter.Name, FallbackValue='Detectando...'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedAdapter.Description, FallbackValue='...'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                    <Border Background="#162232" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedAdapter.SpeedDisplay, FallbackValue='Desconocido'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Tarjeta 2: Gateway & IP -->
                            <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="GATEWAY (ROUTER LOCAL)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    <TextBlock Text="{Binding SelectedAdapter.GatewayAddress, FallbackValue='192.168.1.1'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedAdapter.Ipv4Address, StringFormat='IP Local: {0}', FallbackValue='IP: ...'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedAdapter.Mtu, StringFormat='MTU: {0} bytes', FallbackValue='MTU: 1500'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Tarjeta 3: DNS Actual -->
                            <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SERVIDORES DNS ACTUALES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    <TextBlock Text="{Binding SelectedAdapter.DnsServersDisplay, FallbackValue='Automático / DHCP'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedAdapter.IsDhcpEnabled, StringFormat='Modo DHCP: {0}', FallbackValue='DHCP: Sí'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Tarjeta 4: IP Pública -->
                            <Border Grid.Column="3" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="IP PÚBLICA (OPCIONAL)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                        <Button Style="{StaticResource ModernButton}" Command="{Binding RefreshPublicIpCommand}" Content="↻" Padding="4,0" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Consultar nuevamente IP pública" />
                                    </Grid>
                                    <TextBlock Text="{Binding PublicIp}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="HTTPS seguro (timeout 2s)" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Fila 2: Herramienta de Ping & Jitter Real-Time -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="TELEMETRÍA DE LATENCIA Y JITTER EN TIEMPO REAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,12" />

                                <!-- Controles de Destino y Ejecución -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector y Campo Custom -->
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                            <TextBlock Text="Destino:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushTextSecondary}" />
                                            <ComboBox Width="240" ItemsSource="{Binding PingTargets}" SelectedItem="{Binding SelectedPingTarget}" VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                            <TextBlock Text="Host personalizado:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBox Width="180" Text="{Binding CustomTargetHost, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource ModernButton}" Command="{Binding AddCustomTargetCommand}" Content="Añadir" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Botón Medir -->
                                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding RunPingCommand}" Padding="20,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsTestingPing, Converter={x:Null}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTestingPing}" Value="True">
                                                            <Setter Property="Text" Value="⏳ Midiendo..." />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTestingPing}" Value="False">
                                                            <Setter Property="Text" Value="▶ Medir Ping &amp; Jitter" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>

                                <!-- Métricas Destacadas del Ping Actual (4 Cards) -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource BrushCardAlt}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="LATENCIA MEDIA" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding CurrentPingResult.AvgLatencyMs, StringFormat='{}{0} ms', FallbackValue='--'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource BrushEmerald}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource BrushCardAlt}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="JITTER (FLUCTUACIÓN)" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding CurrentPingResult.JitterMs, StringFormat='{}{0:F1} ms', FallbackValue='--'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource BrushCyan}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource BrushCardAlt}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="PÉRDIDA DE PAQUETES" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding CurrentPingResult.PacketLossPercent, StringFormat='{}{0:F0}%', FallbackValue='--'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource BrushCoral}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{StaticResource BrushCardAlt}" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="RANGO MÍN / MÁX" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}">
                                                <Run Text="{Binding CurrentPingResult.MinLatencyMs, FallbackValue='0'}" />
                                                <Run Text="ms / " Foreground="{StaticResource BrushTextSecondary}" />
                                                <Run Text="{Binding CurrentPingResult.MaxLatencyMs, FallbackValue='0'}" />
                                                <Run Text="ms" Foreground="{StaticResource BrushTextSecondary}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Tabla Historial de Pings -->
                                <Border Background="#0D111A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <DataGrid ItemsSource="{Binding PingHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                                              MinHeight="140" MaxHeight="220"
                                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                              RowBackground="{StaticResource BrushCardAlt}" AlternatingRowBackground="{StaticResource BrushCard}"
                                              Foreground="{StaticResource BrushTextPrimary}" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BrushBorder}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Destino" Binding="{Binding TargetName}" Width="180" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="Host / IP" Binding="{Binding HostOrIp}" Width="140" />
                                            <DataGridTextColumn Header="Promedio" Binding="{Binding AvgLatencyMs, StringFormat='{}{0} ms'}" Width="100" />
                                            <DataGridTextColumn Header="Jitter" Binding="{Binding JitterMs, StringFormat='{}{0:F1} ms'}" Width="100" />
                                            <DataGridTextColumn Header="Pérdida" Binding="{Binding PacketLossPercent, StringFormat='{}{0:F0}%'}" Width="90" />
                                            <DataGridTextColumn Header="Detalle" Binding="{Binding StatusMessage}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: DNS BENCHMARK -->
            <TabItem Header="🌐 DNS Benchmark" DataContext="{Binding Dns}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel>
                        <!-- Banner: Requiere Activación de Licencia -->
                        <Border Background="#2A1818" BorderBrush="{StaticResource BrushCoral}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding IsLicensed, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Producto no activado — Herramientas DNS protegidas" FontWeight="Bold" Foreground="{StaticResource BrushCoral}" FontSize="13" />
                                        <TextBlock Text="Se requiere una licencia activa para realizar benchmarks comparativos y configurar servidores DNS." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                        Command="{Binding DataContext.NavigateToLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="🔑 Activar Licencia" Padding="14,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Barra de Estado y Acciones DNS -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="Adaptador Activo:" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#1A2535" CornerRadius="4" Padding="8,3" Margin="8,0,16,0">
                                        <TextBlock Text="{Binding ActiveAdapterName}" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    </Border>
                                    <TextBlock Text="DNS Actual:" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDnsDisplay}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- Botones con WrapPanel para adaptabilidad perfecta -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding RunBenchmarkCommand}" Content="⚡ Probar Velocidad de Servidores DNS" Padding="16,8" Margin="0,0,10,6" />
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding ApplySelectedPresetCommand}" Content="Aplicar Preset Seleccionado" Padding="14,8" Margin="0,0,10,6" />
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding RestoreDhcpCommand}" Content="Restaurar a DHCP Automático" Padding="14,8" Margin="0,0,10,6" />
                                    <Button Style="{StaticResource RollbackButton}" Command="{Binding RollbackDnsCommand}" Content="↺ Revertir a DNS Original" Padding="14,8" Margin="0,0,0,6"
                                            IsEnabled="{Binding CanRollback}" ToolTip="Restaura la configuración exacta que tenía tu adaptador antes de cualquier cambio" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Panel de Presets y Resultados -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Lista de Presets -->
                            <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="PRESETS DE SERVIDORES DNS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,12" />
                                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushCardAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProviderName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,6" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Primario: " FontSize="11" Foreground="{StaticResource BrushCyan}" />
                                                            <TextBlock Text="{Binding PrimaryDns}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                            <TextBlock Text="Secundario: " FontSize="11" Foreground="{StaticResource BrushCyan}" />
                                                            <TextBlock Text="{Binding SecondaryDns}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Resultados del Benchmark -->
                            <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="RESULTADOS DEL BENCHMARK REAL" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushCyan}" />
                                    <TextBlock Text="Medición de resolución real de dominios mediante socket UDP 53 sin caché. El usuario decide cuál utilizar." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" Margin="0,6,0,12" />

                                    <Border Background="#0D111A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                        <DataGrid ItemsSource="{Binding BenchmarkResults}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  MinHeight="180" MaxHeight="300"
                                                  Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                                  RowBackground="{StaticResource BrushCardAlt}" AlternatingRowBackground="{StaticResource BrushCard}"
                                                  Foreground="{StaticResource BrushTextPrimary}" GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource BrushBorder}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Proveedor" Binding="{Binding ProviderName}" Width="160" FontWeight="Bold" />
                                                <DataGridTextColumn Header="IP Servidor" Binding="{Binding ServerIp}" Width="120" />
                                                <DataGridTextColumn Header="Tiempo de Respuesta" Binding="{Binding ResponseTimeDisplay}" Width="160" FontWeight="Black" />
                                                <DataGridTextColumn Header="Disponibilidad" Binding="{Binding StatusMessage}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: OPTIMIZACIONES SEGURAS -->
            <TabItem Header="🚀 Optimizaciones" DataContext="{Binding Optimizations}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel>
                        <!-- Banner: Requiere Activación de Licencia -->
                        <Border Background="#2A1818" BorderBrush="{StaticResource BrushCoral}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding IsLicensed, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Producto no activado — Optimizaciones de red protegidas" FontWeight="Bold" Foreground="{StaticResource BrushCoral}" FontSize="13" />
                                        <TextBlock Text="Se requiere una licencia activa para aplicar o revertir TCP Auto-Tuning y Receive-Side Scaling." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                        Command="{Binding DataContext.NavigateToLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="🔑 Activar Licencia" Padding="14,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Barra de Estado -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Estado:" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusNotice}" Foreground="{StaticResource BrushEmerald}" FontWeight="Bold" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource ModernButton}" Command="{Binding RefreshStatesCommand}" Content="↻ Re-escanear Estados" HorizontalAlignment="Right" Padding="12,6" />
                            </Grid>
                        </Border>

                        <!-- Tarjeta 1: TCP Auto-Tuning -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐 TCP Window Auto-Tuning" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                        <Border Background="#162232" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Protocolo TCP/IP" FontSize="11" Foreground="{StaticResource BrushCyan}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1A2230" CornerRadius="4" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Estado en Windows: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding TcpState}" FontSize="12" FontWeight="Black" Foreground="{StaticResource BrushEmerald}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding TcpOptimization.TechnicalExplanation}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,10,0,14" LineHeight="18" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyTcpCommand}" Content="Restaurar a Estándar 'Normal'" Padding="16,7" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource RollbackButton}" Command="{Binding RollbackTcpCommand}" Content="↺ Revertir al Estado Original" Padding="14,7"
                                            IsEnabled="{Binding CanRollbackTcp}" ToolTip="Restaura el valor original respaldado" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tarjeta 2: RSS -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️ Receive-Side Scaling (RSS)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                        <Border Background="#162232" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tarjeta de Red Física" FontSize="11" Foreground="{StaticResource BrushCyan}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1A2230" CornerRadius="4" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Estado en Windows: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding RssState}" FontSize="12" FontWeight="Black" Foreground="{StaticResource BrushEmerald}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding RssOptimization.TechnicalExplanation}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,10,0,14" LineHeight="18" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyRssCommand}" Content="Habilitar RSS en Adaptador Activo" Padding="16,7" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource RollbackButton}" Command="{Binding RollbackRssCommand}" Content="↺ Revertir al Estado Original" Padding="14,7"
                                            IsEnabled="{Binding CanRollbackRss}" ToolTip="Restaura el estado previo en el adaptador" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: MANTENIMIENTO -->
            <TabItem Header="🧹 Mantenimiento" DataContext="{Binding Maintenance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel>
                        <!-- Banner: Requiere Activación de Licencia -->
                        <Border Background="#2A1818" BorderBrush="{StaticResource BrushCoral}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Visibility="{Binding IsLicensed, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Producto no activado — Tareas de mantenimiento protegidas" FontWeight="Bold" Foreground="{StaticResource BrushCoral}" FontSize="13" />
                                        <TextBlock Text="Se requiere una licencia activa para vaciar cachés DNS/ARP y renovar concesión DHCP." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                        Command="{Binding DataContext.NavigateToLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="🔑 Activar Licencia" Padding="14,6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Barra de Estado -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Última Acción:" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastActionStatus}" Foreground="{StaticResource BrushCyan}" FontWeight="Bold" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Flush DNS -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🧹 Vaciar Caché de Resolución DNS (Flush DNS)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Borra las entradas cacheadas en el cliente DNS local de Windows mediante la API DnsFlushResolverCache. No desconecta la red y no requiere administrador." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding FlushDnsCommand}" Content="Vaciar Caché DNS" Padding="18,10" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Tarjeta Flush ARP -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔄 Vaciar Tabla de Caché ARP" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Elimina la tabla de asignación entre direcciones IP y MAC en la red local para resolver conflictos tras reiniciar routers. Requiere elevación UAC." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding FlushArpCommand}" Content="Vaciar Tabla ARP" Padding="18,10" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Tarjeta Renovar DHCP -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡 Renovar Concesión DHCP" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                        <Border Background="#352618" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ Pausa temporal de red (1-3s)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAmber}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Solicita una nueva dirección IP al router mediante ipconfig /renew. Provocará una breve desconexión temporal de 1 a 3 segundos mientras se negocia la conexión." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding RenewDhcpCommand}" Content="Renovar DHCP" Padding="18,10" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: LICENCIA -->
            <TabItem Header="🔑 Licencia" DataContext="{Binding Licensing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Panel Izquierdo: Estado -->
                        <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ESTADO DEL PRODUCTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                <TextBlock Text="{Binding StatusInfo.StatusText}" FontSize="18" FontWeight="Black" Margin="0,8,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusInfo.IsLicensed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushEmerald}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusInfo.IsLicensed}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAmber}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Detalles en Grid -->
                                <Border Background="{StaticResource BrushCardAlt}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Producto:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                            <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="ProductSlug:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                            <TextBlock Text="{Binding ProductSlug}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Expiración:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                            <TextBlock Text="{Binding StatusInfo.ExpirationDate, FallbackValue='Permanente'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- HWID Fingerprint -->
                                <TextBlock Text="Identificador de Hardware (HWID):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,16">
                                    <TextBox Text="{Binding StatusInfo.HardwareId}" IsReadOnly="True" Padding="8,6" FontSize="11" FontFamily="Consolas" />
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding CopyHwidCommand}" Content="Copiar" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding ValidateLicenseCommand}" Content="Validar con Servidor" Padding="14,8" Margin="0,0,10,6" />
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding DeactivateCommand}" Content="Desvincular Licencia" Padding="14,8" Margin="0,0,0,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding FeedbackMessage}" FontSize="12" Foreground="{StaticResource BrushCyan}" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Panel Derecho: Activación -->
                        <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVAR NUEVA LICENCIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                <TextBlock Text="Introduce la clave de producto oficial para habilitar todas las funcionalidades avanzadas." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,16" TextWrapping="Wrap" />

                                <TextBlock Text="Clave de Licencia:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontFamily="Consolas" Padding="10,8" Margin="0,0,0,16" />

                                <Button Style="{StaticResource AccentButton}" Command="{Binding ActivateKeyCommand}" Content="🔑 Activar Dispositivo" Padding="18,10" HorizontalAlignment="Left" />

                                <Border Background="#131C28" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Seguridad Oficial" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,6" />
                                        <TextBlock Text="• Validación criptográfica HTTPS con el backend oficial en gestor-claves-backend.onrender.com." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="• Caché local cifrada con Windows Data Protection API (DPAPI)." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: LOGS -->
            <TabItem Header="📜 Registro" DataContext="{Binding Logs}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📜 Registro de Actividad y Auditoría" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="(Sanitizado: jamás almacena claves ni secretos)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ModernButton}" Command="{Binding CopyLogsCommand}" Content="Copiar Todo" Padding="10,4" Margin="0,0,8,0" FontSize="12" />
                                <Button Style="{StaticResource ModernButton}" Command="{Binding ClearLogsCommand}" Content="Limpiar" Padding="10,4" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Consola de Logs con Scroll Automático -->
                    <Border Grid.Row="1" Background="#090C12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" Margin="0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 2. STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource BrushEmerald}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Versión actual: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBlock Text="{Binding Update.CurrentVersion, FallbackValue='1.0.0'}" Foreground="{StaticResource BrushEmerald}" FontWeight="Bold" FontSize="11" Margin="0,0,16,0" />
                    <TextBlock Text="Producto: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBlock Text="network-optimizer" Foreground="{StaticResource BrushCyan}" FontWeight="Bold" FontSize="11" Margin="0,0,16,0" />
                    <TextBlock Text="Plataforma: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBlock Text=".NET 8 LTS (WPF)" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
